DATABASE_URL="file:./dev.db"
# Optional: enable real LLM-based extraction/answers via OpenAI + Vercel AI SDK.
# Falls back to rule-based logic if unset.
OPENAI_API_KEY=your_openai_api_key_here
# Optional: override the OpenAI chat model (defaults to gpt-4o-mini).
OPENAI_MODEL=gpt-4o-mini
SESSION_COOKIE_NAME=shamba_session
